      "source": [
        "#count digits\n",
        "n = 5873\n",
        "def countDigits(n):\n",
        "    cnt = 0\n",
        "    while n > 0:\n",
        "        cnt = cnt + 1\n",
        "        n = n // 10\n",
        "    return cnt"
